/**
 * New Castle, DE Weather Engine
 * Target: Fetches, structures, and outputs live localized API metrics
 */

const LATITUDE = 39.6621;
const LONGITUDE = -75.5666;
const API_URL = `https://open-meteo.com{LATITUDE}&longitude=${LONGITUDE}&current=temperature_2m,wind_speed_10m&hourly=temperature_2m,relative_humidity_2m,wind_speed_10m&temperature_unit=fahrenheit&wind_speed_unit=mph&timezone=America%2FNew_York`;

async function fetchWeatherData() {
  const outputElement = document.getElementById('json-output');
  const badgeElement = document.querySelector('.status-badge');

  try {
    const response = await fetch(API_URL);

    if (!response.ok) {
      throw new Error(`Server responded with code: ${response.status}`);
    }

    const data = await response.json();

    const structuralMatch = {
      location: {
        city: "New Castle",
        state: "DE",
        coordinates: `${LATITUDE}, ${LONGITUDE}`
      },
      current: {
        time: data.current.time,
        temperature_2m: `${data.current.temperature_2m} °F`,
        wind_speed_10m: `${data.current.wind_speed_10m} mph`
      },
      hourly: {
        time: data.hourly.time.slice(0, 6),
        temperature_2m: data.hourly.temperature_2m.slice(0, 6),
        relative_humidity_2m: data.hourly.relative_humidity_2m.slice(0, 6),
        wind_speed_10m: data.hourly.wind_speed_10m.slice(0, 6)
      }
    };

    outputElement.textContent = JSON.stringify(structuralMatch, null, 2);
    badgeElement.textContent = "Live API Status: Active / Stable";
    badgeElement.style.color = "#04d361";

  } catch (error) {
    console.error("API Pipeline Error:", error);
    outputElement.textContent = `// Error fetching live metrics.\n// ${error.message}`;
    badgeElement.textContent = "Live API Status: Connection Broken";
    badgeElement.style.color = "#df4040";
  }
}

document.addEventListener('DOMContentLoaded', fetchWeatherData);
